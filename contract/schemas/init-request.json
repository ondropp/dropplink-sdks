{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios"
      ]
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "device": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "osVersion": {
          "type": "string",
          "maxLength": 32
        },
        "locale": {
          "type": "string",
          "maxLength": 35
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        },
        "screen": {
          "type": "object",
          "properties": {
            "w": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 20000
            },
            "h": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 20000
            },
            "dpr": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "w",
            "h",
            "dpr"
          ]
        }
      },
      "required": [
        "model",
        "osVersion",
        "locale",
        "timezone"
      ]
    },
    "installReferrer": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "string",
          "maxLength": 2048
        },
        "clickId": {
          "type": "string",
          "maxLength": 64
        },
        "referrerClickTs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "installBeginTs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "raw"
      ]
    },
    "reinstallKey": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "installId",
    "platform",
    "appVersion",
    "sdkVersion",
    "device"
  ]
}
